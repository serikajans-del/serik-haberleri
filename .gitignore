# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# haber videosu çalışma dosyaları
/video/calisma/
/video/*.mp4
/video/reklam/
/video/muzekart/
/video/kusyuvasi/
/video/discovereu/

# Serik haber masası: gizli anahtarlı WP kodu ve çalışma dosyaları
masa/wp/
masa/gorulen.json
masa/adaylar.json
masa/taslak/
masa/log/
masa/gelen/
masa/telegram/

# X masası durum/görselleri (22 Kas 2026)
masa/x/*
!masa/x/XMASA.md
!masa/x/xmasa.mjs

# Viral radar (haberantalya_bot) çalışma dosyaları
masa/radar/tur.json
masa/radar/gorulen.json
masa/radar/aday.json
masa/radar/durum.json
masa/radar/geribildirim.json
masa/radar/log.txt

# @haberinilki radar: durum dosyaları yerel kalır
masa/haberinilki-radar/*.json
masa/haberinilki-radar/reported.txt
masa/haberinilki-radar/images/
masa/haberinilki-radar/tmp/
